<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EA"
    android:fillViewport="true"
    tools:context=".AccountFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#263F35"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="25dp"/>

        <!-- Profile Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="25dp">

                <!-- Profile Image -->
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/account_svg_vector"
                    android:scaleType="centerCrop"
                    android:background="#D9E4D8"
                    android:padding="12dp"
                    app:tint="#263F35"
                    android:contentDescription="Profile picture"/>

                <!-- Profile Heading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Profile"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#263F35"
                    android:layout_marginTop="15dp"/>

                <!-- Profile Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your profile picture"
                    android:textSize="14sp"
                    android:textColor="#78977B"
                    android:layout_marginTop="5dp"/>

                <!-- Edit Button -->
                <Button
                    android:id="@+id/btnPickImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Edit Profile Picture"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#263F35"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
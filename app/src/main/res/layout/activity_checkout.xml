<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Checkout Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#263F35"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="25dp"/>

        <!-- Order Summary Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Order Summary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#263F35"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtOrderSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your items will appear here."
                    android:textSize="15sp"
                    android:textColor="#78977B"
                    android:padding="10dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D9E4D8"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"/>

                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Price: $0.00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#263F35"
                    android:gravity="center"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Confirm Order Button -->
        <Button
            android:id="@+id/confirmBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Place Order"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263F35"
            android:layout_marginTop="25dp"/>

        <!-- Cancel Button -->
        <Button
            android:id="@+id/cancelBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#263F35"
            android:backgroundTint="#D9E4D8"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>